<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>STARK JET - DESIGNER REALISTA</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;overflow:hidden;font-family:monospace;color:#0ff}
#header{background:linear-gradient(90deg,#001,#003);border-bottom:2px solid #0ff;padding:10px;text-align:center;box-shadow:0 0 20px #0ff}
#header h1{font-size:14px;letter-spacing:3px}
#stage{display:flex;height:90vh}
#holo{flex:2;background:radial-gradient(circle at center,#001a33 0%,#000 70%);position:relative;display:flex;justify-content:center;align-items:center;overflow:hidden}
#holo::before{content:'';position:absolute;width:100%;height:100%;background:repeating-linear-gradient(0deg,rgba(0,255,255,0.03) 0 1px,transparent 1px 20px);pointer-events:none}
#suit{width:320px;height:560px;position:relative;filter:drop-shadow(0 0 20px #0ff)}
.suit-part{position:absolute;background-size:cover;transition:all 0.4s}
#head{top:10px;left:90px;width:140px;height:110px;background:var(--c1);border-radius:70% 70% 30% 30% / 60% 60% 40% 40%;box-shadow:inset -10px -10px 20px rgba(0,0,0,0.8),inset 10px 10px 20px rgba(255,255,255,0.2)}
#eyeL,#eyeR{position:absolute;top:30px;width:45px;height:30px;background:#fff;border:3px solid #000;border-radius:50% 20% 50% 20%;box-shadow:0 0 15px #fff, inset 0 0 10px #aaf}
#eyeL{left:10px;transform:rotate(-10deg)} #eyeR{right:10px;transform:rotate(10deg)}
#torso{top:125px;left:45px;width:230px;height:190px;background:linear-gradient(180deg,var(--c1) 0%,var(--c1) 40%,var(--c2) 40%,var(--c2) 100%);clip-path:polygon(15% 0,85% 0,100% 20%,95% 100%,5% 100%,0% 20%);box-shadow:inset 0 -20px 30px rgba(0,0,0,0.6)}
#muscleL,#muscleR{position:absolute;top:10px;width:20px;height:80%;background:rgba(0,0,0,0.3);filter:blur(3px)}
#muscleL{left:20%} #muscleR{right:20%}
#chest-logo{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:50px;filter:drop-shadow(0 0 10px #000)}
#armL{top:135px;left:5px;width:55px;height:160px;background:var(--c2);border-radius:30px 10px 20px 30px;transform:rotate(5deg);box-shadow:inset -5px -5px 15px rgba(0,0,0,0.7)}
#armR{top:135px;right:5px;width:55px;height:160px;background:var(--c2);border-radius:10px 30px 30px 20px;transform:rotate(-5deg);box-shadow:inset 5px -5px 15px rgba(0,0,0,0.7)}
#legL{top:320px;left:60px;width:80px;height:230px;background:linear-gradient(180deg,var(--c1),var(--c1) 60%,var(--c2) 60%);border-radius:20px 20px 10px 10px;box-shadow:inset -8px 0 15px rgba(0,0,0,0.6)}
#legR{top:320px;right:60px;width:80px;height:230px;background:linear-gradient(180deg,var(--c1),var(--c1) 60%,var(--c2) 60%);border-radius:20px 20px 10px 10px;box-shadow:inset 8px 0 15px rgba(0,0,0,0.6)}
.web{position:absolute;inset:0;opacity:var(--web);pointer-events:none;background-image:radial-gradient(circle,transparent 60%,rgba(0,0,0,0.8) 61%),repeating-linear-gradient(0deg,transparent 0 18px,rgba(0,0,0,0.5) 18px 19px),repeating-linear-gradient(90deg,transparent 0 18px,rgba(0,0,0,0.5) 18px 19px)}

#controls{flex:1;background:#020a14;border-left:2px solid #0ff;padding:12px;overflow-y:auto}
.group{background:rgba(0,50,100,0.2);border:1px solid #0ff3;border-radius:12px;padding:10px;margin-bottom:12px;backdrop-filter:blur(5px)}
.group h3{font-size:11px;color:#0ff;margin-bottom:8px;letter-spacing:1px}
.row{display:flex;gap:5px;flex-wrap:wrap}
button{padding:7px 11px;background:rgba(0,0,0,0.6);border:1px solid #0ff;color:#0ff;border-radius:20px;font-size:11px}
button.on{background:#0ff;color:#000;box-shadow:0 0 12px #0ff;font-weight:bold}
input[type=color]{width:48%;height:35px;border:2px solid #0ff;border-radius:8px;background:#000}
input[type=range]{width:100%;accent-color:#0ff}
#save{width:100%;padding:14px;background:linear-gradient(90deg,#f00,#a00);color:#fff;border:none;border-radius:25px;font-weight:bold;letter-spacing:2px;box-shadow:0 0 20px #f00a;margin-top:10px}
#base{position:absolute;bottom:20px;width:200px;height:10px;background:radial-gradient(ellipse,#0ff 0%,transparent 70%);border-radius:50%;filter:blur(2px)}
</style>
</head>
<body>
<div id="header"><h1>🛩️ STARK JET LAB // DESIGNER REALISTA // MARK-47</h1></div>
<div id="stage">
<div id="holo">
<div id="suit" style="--c1:#cc0000;--c2:#0011ff;--web:0">
<div id="head" class="suit-part"><div id="eyeL"></div><div id="eyeR"></div><div class="web"></div></div>
<div id="torso" class="suit-part"><div id="muscleL"></div><div id="muscleR"></div><div id="chest-logo">🕷️</div><div class="web"></div></div>
<div id="armL" class="suit-part"><div class="web"></div></div>
<div id="armR" class="suit-part"><div class="web"></div></div>
<div id="legL" class="suit-part"><div class="web"></div></div>
<div id="legR" class="suit-part"><div class="web"></div></div>
<div id="base"></div>
</div>
</div>
<div id="controls">
<div class="group"><h3>🎨 COR BASE / TECIDO</h3><div class="row"><input type="color" id="c1" value="#cc0000"><input type="color" id="c2" value="#0011ff"></div></div>
<div class="group"><h3>👁️ LENTES REALISTAS</h3><div class="row">
<button onclick="eyes('normal')" class="on">Normal Filme</button>
<button onclick="eyes('big')">Grande MCU</button>
<button onclick="eyes('small')">Tático</button>
<button onclick="eyes('angry')">Raiva</button>
</div></div>
<div class="group"><h3>💎 MATERIAL</h3><div class="row">
<button onclick="material('tecido')" class="on">Tecido</button>
<button onclick="material('metal')">Metal</button>
<button onclick="material('stealth')">Stealth Fosco</button>
<button onclick="material('brilho')">Nano Brilho</button>
</div></div>
<div class="group"><h3>🕸️ MALHA / TEIA</h3><input type="range" id="webR" min="0" max="1" step="0.05" value="0"><div style="font-size:9px;display:flex;justify-content:space-between"><span>SEM</span><span>COMPLETA FILME</span></div></div>
<div class="group"><h3>🛡️ LOGO PEITO</h3><div class="row">
<button onclick="logo('🕷️')" class="on">🕷️</button>
<button onclick="logo('◼️')">Iron</button>
<button onclick="logo('★')">Vingador</button>
<button onclick="logo('')">Nenhum</button>
</div></div>
<button id="save" onclick="exportar()">⚡ FABRICAR TRAJE - EXPORTAR</button>
<div style="font-size:9px;color:#0ff8;margin-top:8px;text-align:center">TOQUE HOLOGRÁFICO • 3000 VARIAÇÕES • RENDER REALISTA</div>
</div>
</div>
<script>
const suit=document.getElementById('suit');
document.getElementById('c1').oninput=e=>suit.style.setProperty('--c1',e.target.value);
document.getElementById('c2').oninput=e=>suit.style.setProperty('--c2',e.target.value);
document.getElementById('webR').oninput=e=>suit.style.setProperty('--web',e.target.value);
function eyes(t){
 let l=document.getElementById('eyeL'),r=document.getElementById('eyeR');
 if(t=='normal'){l.style.cssText='left:10px;top:30px;width:45px;height:30px;transform:rotate(-10deg)';r.style.cssText='right:10px;top:30px;width:45px;height:30px;transform:rotate(10deg)'}
 if(t=='big'){l.style.cssText='left:5px;top:20px;width:60px;height:50px;transform:rotate(-5deg)';r.style.cssText='right:5px;top:20px;width:60px;height:50px;transform:rotate(5deg)'}
 if(t=='small'){l.style.cssText='left:15px;top:38px;width:40px;height:12px;transform:rotate(0deg)';r.style.cssText='right:15px;top:38px;width:40px;height:12px;transform:rotate(0deg)'}
 if(t=='angry'){l.style.cssText='left:8px;top:28px;width:50px;height:28px;transform:rotate(-25deg);border-radius:10% 80% 20% 80%';r.style.cssText='right:8px;top:28px;width:50px;height:28px;transform:rotate(25deg);border-radius:80% 10% 80% 20%'}
}
function logo(v){document.getElementById('chest-logo').innerText=v=='◼️'?'⬢':v;}
function material(m){
 let s=document.getElementById('suit');
 if(m=='tecido')s.style.filter='drop-shadow(0 0 15px #0ff) brightness(1)';
 if(m=='metal')s.style.filter='drop-shadow(0 0 20px #fff) contrast(1.3) brightness(1.2)';
 if(m=='stealth')s.style.filter='brightness(0.4) drop-shadow(0 0 5px #333)';
 if(m=='brilho')s.style.filter='drop-shadow(0 0 30px #ff0) brightness(1.3) saturate(1.5)';
}
function exportar(){
 alert('TRAJE REALISTA FABRICADO!\\nCores: '+document.getElementById('c1').value+' + '+document.getElementById('c2').value+'\\nPronto para exportar!');
 if(navigator.vibrate)navigator.vibrate([100,50,200]);
 document.getElementById('suit').animate([{transform:'scale(1)'},{transform:'scale(1.1)'},{transform:'scale(1)'}],{duration:500});
}
document.querySelectorAll('.group .row button').forEach(b=>{
 b.addEventListener('click',function(){
   if(this.parentElement.parentElement.querySelector('h3').innerText.includes('LENTES')||this.parentElement.parentElement.querySelector('h3').innerText.includes('MATERIAL')||this.parentElement.parentElement.querySelector('h3').innerText.includes('LOGO')){
     this.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('on'));this.classList.add('on');
   }
 });
});
</script>
</body>
</html>
